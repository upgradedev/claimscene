# ── ClaimScene web client configuration ─────────────────────────────────────
# Copy to `.env` (or `.env.local`) to point the dev server at a backend.
#
# Production needs NOTHING here: the FastAPI container serves the compiled
# client from the same origin, so the app uses relative paths and there is no
# CORS. These knobs only shape the Vite dev proxy.

# Absolute API base. Leave EMPTY in production (relative, same-origin). In dev,
# requests to /health, /scenarios and /cases are proxied to this target.
VITE_API_BASE=

# Dev-only override for the proxy target (defaults to VITE_API_BASE, then to a
# local backend at http://localhost:8000). Point it at a running FastAPI dev
# server (`uvicorn claimscene.api:app --reload`) or a deployed Cloud Run URL.
VITE_DEV_PROXY_TARGET=http://localhost:8000
