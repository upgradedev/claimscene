# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.venv/
venv/
.mypy_cache/
.coverage

# Node / frontend web client
node_modules/
*.tsbuildinfo
.vite/
frontend/coverage/

# Playwright (end-to-end journey / a11y / responsive) — regenerated each run
frontend/test-results/
frontend/playwright-report/
frontend/playwright/.cache/
frontend/.lighthouseci/
frontend/lhci-report/

# Env / secrets — NEVER commit real credentials
.env
.env.*
!.env.example

# Generated pipeline output
out/
# Demo-video build scratch (TTS clips, per-beat renders, concat lists).
.artifacts/
*.mp4
# Committed evidence exceptions: the live-illustration proof clip is sealed
# by hash in eval/evidence (verified by the readiness gate).
!eval/evidence/**/*.mp4
# The narrated demo walkthrough (ElevenLabs voiceover, built by
# scripts/build_video.py) is a committed submission artifact.
!demo/*.mp4

# Readiness gate output (regenerated each run; archived as a CI artifact)
readiness.json

# OS / editor
.DS_Store
.idea/
.vscode/

# PII SAFETY: never commit real accident photos or personal media.
# The repo uses SYNTHETIC / staged inputs only (see README: synthetic-data policy).
*.jpg
*.jpeg
*.heic
*.png
!tests/golden/**
# The eval set + live evidence are SYNTHETIC seedream renders of toy
# dioramas (source: synthetic_generated, sealed in eval/scenarios/manifest
# .json and eval/evidence) — the only imagery this repo may carry.
!eval/scenarios/**/*.jpg
!eval/evidence/**/*.png
# Demo-video source cards (synthetic forensic-blueprint marketing art — no
# real photos/people/plates). Read by scripts/build_video.py.
!demo/assets/*.png
# Curated frontend brand/example assets (synthetic only — no real photos).
# hero-illustration.jpg is a downscaled crop of the sealed live-evidence
# toy-diorama render (eval/evidence/live_illustration/illustration.png).
!frontend/src/assets/*.jpg
# Brand icons served from the web root. Drawn from the Wordmark's own geometry
# by code (a crosshair on a dark plate) — vector art, never a photograph.
!frontend/public/*.png
private/
real-photos/
eval/scenarios/_spend.json
