# ── ClaimScene configuration ────────────────────────────────────────────────
# Copy to `.env` and fill in for the LIVE path. The default (offline) needs
# NONE of these — the pipeline runs fully with deterministic fakes, so CI and
# local demos work with zero credentials.

# offline (default, fakes, no creds) | live (real B2 + VLM + Genblaze)
CLAIMSCENE_MODE=offline

# ── Backblaze B2 (S3-compatible) — required when CLAIMSCENE_MODE=live ────────
# Canonical Backblaze names are primary; the legacy aliases on the right are
# also accepted (resolution lives in src/claimscene/config.py):
#   B2_APPLICATION_KEY_ID   or  B2_KEY_ID
#   B2_APPLICATION_KEY      or  B2_APP_KEY
#   B2_S3_ENDPOINT          or  B2_ENDPOINT_URL  (a missing https:// is added)
# B2_BUCKET_NAME is the same name either way.
B2_BUCKET_NAME=claimscene-demo
B2_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_APPLICATION_KEY_ID=your-application-key-id
B2_APPLICATION_KEY=your-application-key
# Optional key prefix ("folder") prepended to every object key AND index.jsonl
# (alias: B2_PREFIX). Leave unset to write at the bucket root.
# B2_KEY_PREFIX=claimscene/

# ── Genblaze generative provider (illustration still + clip) — live mode ─────
# GMI_API_KEY drives BOTH the Genblaze illustration provider (request-queue
# API) and the GMI rungs of the VLM ladder (OpenAI-compatible serving API).
# Models: seedream-5.0-lite (still), pixverse-v6-i2v (clip default),
# Kling-Image2Video-V2.1-Master (premium clip option).
GENBLAZE_PROVIDER=gmicloud
GMI_API_KEY=

# ── Vision extractor (photos → constrained SceneGraph) — live mode only ──────
# Ladder: GMI google/gemma-4-31b-it → GMI google/gemini-3.5-flash → Nebius
# Qwen/Qwen2.5-VL-72B-Instruct. GMI rungs need GMI_API_KEY (above); the
# Nebius fallback rung needs both NEBIUS_* values and is skipped otherwise.
# GMI_SERVING_BASE_URL overrides the OpenAI-compatible serving endpoint
# (default https://api.gmi-serving.com/v1 — distinct from the request-queue
# API the Genblaze provider talks to).
# GMI_SERVING_BASE_URL=
NEBIUS_INFERENCE_BASE_URL=
NEBIUS_INFERENCE_API_KEY=
